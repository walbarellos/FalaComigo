# Android GitIgnore
*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
/google-services.json

# User-specific configuration
/app/build
/desktop/build

# Signing files
*.jks
*.keystore
key.properties

# Log files
*.log

# Built APKs (except the root one we want to keep)
/app/build/outputs/apk/*
/app/build/outputs/bundle/*
